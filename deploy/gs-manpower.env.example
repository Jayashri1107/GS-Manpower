# Copy to /etc/gs-manpower.env on the server:
#   sudo cp deploy/gs-manpower.env.example /etc/gs-manpower.env && sudo chmod 600 /etc/gs-manpower.env
# then fill in the values. Never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
DATA_DIR=/var/lib/gs-manpower
TRUST_PROXY=1
PUBLIC_URL=https://www.gsmanpower.in

# From: node scripts/setup.js --print   (keep a copy of DATA_KEY in a password manager)
DATA_KEY=
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Lead alerts (optional, any combination) – see docs/DEPLOY.md step 4
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=GS Manpower Website <website@gsmanpower.in>
NOTIFY_EMAIL_TO=
NOTIFY_WEBHOOK_URL=
