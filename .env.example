# Copy to .env for local use (npm run setup creates .env for you). On a host, set these as environment variables.

# --- Required in production ---
NODE_ENV=production
# 32-byte key, base64. Generate with: npm run setup -- --print   KEEP IT SAFE: without it stored data is unreadable.
DATA_KEY=
ADMIN_USER=admin
# scrypt hash of the admin password. Generate with: npm run setup -- --print
ADMIN_PASSWORD_HASH=
# Where encrypted submissions are stored. Must be a persistent disk on the host.
DATA_DIR=/var/data
# Public address, used in notification links
PUBLIC_URL=https://www.gsmanpower.in
PORT=8080
# 1 when running behind a proxy/load balancer that sets X-Forwarded-For (Render, Railway, Nginx). Default on in production.
TRUST_PROXY=1

# --- Optional: lead notifications (any combination) ---
# Email via Resend (https://resend.com). The from-address domain must be verified in Resend.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=GS Manpower Website <website@gsmanpower.in>
NOTIFY_EMAIL_TO=info@gsmanpower.in
# Slack, Google Chat, Microsoft Teams or any webhook that accepts {"text": "..."}
NOTIFY_WEBHOOK_URL=
# WhatsApp Business Cloud API. Needs an approved template with one body variable.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=91XXXXXXXXXX
WHATSAPP_TEMPLATE=new_lead_alert
WHATSAPP_TEMPLATE_LANG=en

# --- Optional: retention in days (must match the privacy notice) ---
RETAIN_ENQUIRY_DAYS=730
RETAIN_APPLICATION_DAYS=365
